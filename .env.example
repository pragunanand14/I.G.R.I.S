# IGRIS configuration
# Copy to `.env` (never commit it). IGRIS looks for `.env` in:
#   1. the application config directory (e.g. %APPDATA%\dev.igris.app\.env on Windows)
#   2. the current working directory (useful during development)
# Real environment variables always take precedence over `.env` files.
# Secrets are read only by the native backend and are never sent to the UI.

# --- AI (Phase 2) ---
# anthropic | openai | gemini | local
# gemini: free key at https://aistudio.google.com/apikey; set AI_MODEL to a model listed there
#   (e.g. gemini-2.5-flash). Free tier has rate limits, and Google may use free-tier prompts
#   to improve its products.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional: override the provider endpoint (local defaults to Ollama at http://localhost:11434/v1)
AI_BASE_URL=
# Optional models for specific jobs, on the same provider (default: AI_MODEL for everything):
#   AI_VISION_MODEL — used for messages with images when AI_MODEL can't read them
#   AI_FAST_MODEL   — used to condense earlier messages of long conversations
AI_VISION_MODEL=
AI_FAST_MODEL=
# Optional: the model's context window in tokens. IGRIS knows the hosted models; set this for
# local servers (match OLLAMA_CONTEXT_LENGTH / the server's context size). Default for local: 16384.
AI_CONTEXT_WINDOW=
# Ollama: IGRIS's instructions + tool list are ~7k tokens, more than Ollama's default
# 4096-token context, which silently cuts them off. Set the Windows/user environment
# variable OLLAMA_CONTEXT_LENGTH=16384 (or 8192 on low-RAM machines) and restart Ollama.
# Pick a model with "tools" support; reasoning models (qwen3, deepseek-r1) think first,
# which is slow on a CPU.

# --- Storage ---
# Optional absolute path to the SQLite database. Defaults to <app data dir>/igris.db
DATABASE_URL=

# --- Web search (Phase 5) ---
# brave | tavily. Leave empty to use Anthropic's built-in web search when AI_PROVIDER=anthropic
# (billed per search on your Anthropic account). Other providers need a Brave or Tavily key.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Voice (Phase 6) ---
# browser (default) uses the system's built-in speech (Windows: WebView2 recognition + SAPI voices).
# groq uses Groq (free tier): Whisper for recognition, natural "Orpheus" voices for replies.
# gemini: recognition and natural voices with your Gemini key (reuses AI_API_KEY when AI_PROVIDER=gemini).
# openai uses OpenAI Whisper / TTS (or any OpenAI-compatible service at VOICE_BASE_URL);
# local uses an OpenAI-compatible speech server at VOICE_BASE_URL.
# Recommended free setup (accurate recognition + a human-sounding voice):
#   STT_PROVIDER=groq
#   TTS_PROVIDER=groq
#   VOICE_API_KEY=<key from console.groq.com>
#   TTS_VOICE=troy          # or daniel, austin (male); hannah, diana, autumn (female)
# (If Groq says the voice model needs its terms accepted, accept them once in the Groq console.)
# Gemini voices instead: TTS_PROVIDER=gemini, TTS_VOICE=Charon (or Kore, Puck, Aoede, Fenrir…);
# the free tier allows few speech requests per day.
STT_PROVIDER=
TTS_PROVIDER=
# Groq key for groq; falls back to AI_API_KEY when AI_PROVIDER=openai
VOICE_API_KEY=
VOICE_BASE_URL=
# Spoken-language hint for recognition (ISO 639-1, e.g. en, hi). Improves accuracy; empty = auto.
STT_LANGUAGE=
# Defaults — groq: whisper-large-v3-turbo / canopylabs/orpheus-v1-english / troy;
# gemini: your chat model / gemini-2.5-flash-preview-tts / Charon; openai: whisper-1 / tts-1 / alloy
STT_MODEL=
TTS_MODEL=
TTS_VOICE=

# --- Logging ---
# Standard tracing filter, e.g. info, debug, igris_lib=debug
IGRIS_LOG=info
