# IGRIS configuration
# Copy to `.env` (never commit it). IGRIS looks for `.env` in:
#   1. the application config directory (e.g. %APPDATA%\dev.igris.app\.env on Windows)
#   2. the current working directory (useful during development)
# Real environment variables always take precedence over `.env` files.
# Secrets are read only by the native backend and are never sent to the UI.

# --- AI (Phase 2) ---
# anthropic | openai | gemini | local
# gemini: free key at https://aistudio.google.com/apikey; set AI_MODEL to a model listed there
#   (e.g. gemini-2.5-flash). Free tier has rate limits, and Google may use free-tier prompts
#   to improve its products.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional: override the provider endpoint (local defaults to Ollama at http://localhost:11434/v1)
AI_BASE_URL=
# Ollama: IGRIS's instructions + tool list are ~7k tokens, more than Ollama's default
# 4096-token context, which silently cuts them off. Set the Windows/user environment
# variable OLLAMA_CONTEXT_LENGTH=16384 (or 8192 on low-RAM machines) and restart Ollama.
# Pick a model with "tools" support; reasoning models (qwen3, deepseek-r1) think first,
# which is slow on a CPU.

# --- Storage ---
# Optional absolute path to the SQLite database. Defaults to <app data dir>/igris.db
DATABASE_URL=

# --- Web search (Phase 5) ---
# brave | tavily. Leave empty to use Anthropic's built-in web search when AI_PROVIDER=anthropic
# (billed per search on your Anthropic account). Other providers need a Brave or Tavily key.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Voice (Phase 6) ---
# browser (default) uses the system's built-in speech (Windows: WebView2 recognition + SAPI voices).
# openai uses OpenAI Whisper / TTS; local uses an OpenAI-compatible speech server at VOICE_BASE_URL.
STT_PROVIDER=
TTS_PROVIDER=
# Falls back to AI_API_KEY when AI_PROVIDER=openai
VOICE_API_KEY=
VOICE_BASE_URL=
# Defaults: whisper-1 / tts-1 / alloy
STT_MODEL=
TTS_MODEL=
TTS_VOICE=

# --- Logging ---
# Standard tracing filter, e.g. info, debug, igris_lib=debug
IGRIS_LOG=info
