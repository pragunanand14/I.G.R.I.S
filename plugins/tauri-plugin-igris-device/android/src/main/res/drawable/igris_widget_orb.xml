<?xml version="1.0" encoding="utf-8"?>
<!-- The IGRIS orb: a glowing blue sphere with a bright core. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="60dp" android:startColor="#665EB8FF" android:centerColor="#225EB8FF" android:endColor="#005EB8FF" />
        </shape>
    </item>
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="60dp" android:centerX="0.42" android:centerY="0.38" android:startColor="#FFE9F5FF" android:centerColor="#FF5EB8FF" android:endColor="#FF1B3F8F" />
        </shape>
    </item>
</layer-list>
