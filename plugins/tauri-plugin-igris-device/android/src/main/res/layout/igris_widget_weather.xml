<?xml version="1.0" encoding="utf-8"?>
<!-- Weather widget: now, today's high/low, the place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/igris_weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/igris_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <TextView
        android:id="@+id/igris_weather_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="⛅"
        android:textSize="38sp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/igris_weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:text="—"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />
        <TextView
            android:id="@+id/igris_weather_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/igris_widget_weather_setup"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/igris_weather_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
