<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voice input: the webview asks for these at runtime when the mic is used. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Battery and network status. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Reminders ring on time even when IGRIS is closed (exact alarms). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- "Text Dad…" / "call Dad": find the number (asked once, when first used) and call it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Location reminders ("when I leave the office"): asked when first used. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- "Hey IGRIS": listen for the name in a foreground service (on only when the user turns it on),
         open IGRIS when it's heard (needs "Display over other apps"), and not be stopped by battery saving. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Location reminders survive a restart (Android forgets proximity alerts then). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility (Android 11+): only apps the launcher can open, not every package. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Home-screen widgets: the orb (tap to talk), clock and date, weather. -->
    <application>
        <receiver android:name="dev.igris.device.OrbWidget" android:exported="false" android:label="@string/igris_widget_orb_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/igris_widget_orb_info" />
        </receiver>
        <receiver android:name="dev.igris.device.ClockWidget" android:exported="false" android:label="@string/igris_widget_clock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/igris_widget_clock_info" />
        </receiver>
        <receiver android:name="dev.igris.device.WeatherWidget" android:exported="false" android:label="@string/igris_widget_weather_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/igris_widget_weather_info" />
        </receiver>
        <!-- Screen reading and control: off until the user turns it on in Android's accessibility settings. -->
        <service
            android:name="dev.igris.device.IgrisAccessibilityService"
            android:exported="false"
            android:label="@string/igris_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/igris_accessibility" />
        </service>
        <receiver android:name="dev.igris.device.PlaceAlertReceiver" android:exported="false" />
        <receiver android:name="dev.igris.device.PlacesBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- "Hey IGRIS" / "Wake up IGRIS", recognised on the phone (WakeWordService.kt). -->
        <service
            android:name="dev.igris.device.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- IGRIS as the phone's digital assistant (Settings → Default apps → Digital assistant app):
             the assistant gesture and a headset's voice button open IGRIS listening. -->
        <activity
            android:name="dev.igris.device.AssistActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Google's sign-in sheet is started from here (GoogleAuthActivity.kt). -->
        <activity
            android:name="dev.igris.device.GoogleAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Message notifications (summaries, replies): off until the user grants Notification access. -->
        <service
            android:name="dev.igris.device.IgrisNotificationListener"
            android:exported="false"
            android:label="@string/igris_notifications_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
